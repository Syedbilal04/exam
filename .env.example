# Copy to .env.local and fill in.
#
# Supabase mode: set ALL THREE values below. Leave all three empty to run in
# local mode (accounts and attempts stored in ./.data). Setting only some of
# them stops the server at boot.
# Example formats:
#   NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
#   SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   (server-only, never expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs local-mode session cookies. Optional in development (a key is generated
# in ./.data/auth-secret); required when running the local store in production.
# Example: AUTH_SECRET=change-me-long-random-string
AUTH_SECRET=

# Set to true only if you accept running production on the local file store
# (./.data is wiped by most hosts on every deploy/restart).
ALLOW_LOCAL_STORE_IN_PRODUCTION=false

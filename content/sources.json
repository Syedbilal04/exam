  "$rejected": [
    {
      "source": "soughed/jee-main-questions, eQOURSE/jee-advanced-questions",
      "reason": "Real JEE papers with topic labels, but the datasets declare no licence and the underlying papers are NTA/IIT copyright. Not usable without written permission."
    },
    {
      "source": "abhay557/indian-exams-rawdata (Kaggle)",
      "reason": "Tagged CC BY 4.0 by the uploader, but the card states the questions remain the property of the conducting bodies and were collected under a fair-use claim. The uploader cannot relicense them."
